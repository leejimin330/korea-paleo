[{"id":"goseong-theropod-tracks","name_ko":"고성 수각류 발자국","scientific_name":null,"taxon_group":"theropod","tree_node_id":"theropoda","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[113,100],"location":{"name":"경남 고성 하이면 덕명리 일대","modern":{"lat":34.955,"lng":128.29},"paleo":{"lat":40.738,"lng":141.898}},"marker_type":"korea","badges":["species_unidentified"],"description":"고성 해안 일대의 진동층에는 수많은 공룡 발자국이 층층이 남아 있습니다. 세 개의 뾰족한 발가락 자국은 두 발로 걷던 육식성 수각류의 것입니다. 발자국만으로는 종을 특정할 수 없어 '수각류' 그룹 단위로 연결했습니다.","sources":["국가유산청 천연기념물 「고성 덕명리 공룡과 새발자국 화석산지」","PBDB"],"pbdb_nearby":58},{"id":"goseong-sauropod-tracks","name_ko":"고성 용각류 발자국","scientific_name":null,"taxon_group":"sauropod","tree_node_id":"sauropoda","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[113,100],"location":{"name":"경남 고성 하이면 덕명리 일대","modern":{"lat":34.94,"lng":128.33},"paleo":{"lat":40.727,"lng":141.943}},"marker_type":"korea","badges":["species_unidentified"],"description":"목과 꼬리가 긴 거대 초식공룡 용각류가 남긴 둥글고 큰 발자국입니다. 여러 마리가 같은 방향으로 걸어간 보행렬도 보고되어 무리 생활의 단서로 해석됩니다.","sources":["국가유산청 천연기념물 「고성 덕명리 공룡과 새발자국 화석산지」","PBDB"],"pbdb_nearby":32},{"id":"goseong-ornithopod-tracks","name_ko":"고성 조각류 발자국","scientific_name":null,"taxon_group":"ornithopod","tree_node_id":"ornithopoda","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[113,100],"location":{"name":"경남 고성 하이면 덕명리 일대","modern":{"lat":34.975,"lng":128.26},"paleo":{"lat":40.755,"lng":141.862}},"marker_type":"korea","badges":["species_unidentified"],"description":"발가락이 뭉툭한 세 갈래 발자국은 이구아노돈과 비슷한 초식공룡 조각류의 것으로 봅니다. 고성 일대에서 가장 흔한 발자국 유형 중 하나입니다.","sources":["국가유산청 천연기념물 「고성 덕명리 공룡과 새발자국 화석산지」","PBDB"],"pbdb_nearby":61},{"id":"jinju-raptor-tracks","name_ko":"진주 랩터 발자국","scientific_name":"Dromaeosauriformipes rarus","taxon_group":"theropod","tree_node_id":"dromaeosauridae","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[113,106],"location":{"name":"경남 진주 (진주층)","modern":{"lat":35.16,"lng":128.1},"paleo":{"lat":40.922,"lng":141.659}},"marker_type":"korea","badges":["trace_fossil"],"description":"두 발가락만 땅에 닿는 독특한 발자국으로, 발톱을 들고 걷던 드로마에오사우루스류(랩터)의 것으로 해석됩니다. 길이 1~2cm 남짓한 매우 작은 발자국이 보고되어 주목받았습니다.","sources":["Kim et al. (2018) Scientific Reports","PBDB"],"pbdb_nearby":130},{"id":"hwasun-theropod-tracks","name_ko":"화순 서유리 수각류 발자국","scientific_name":null,"taxon_group":"theropod","tree_node_id":"theropoda","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[100,85],"location":{"name":"전남 화순 북면 서유리","modern":{"lat":35.13,"lng":127.02},"paleo":{"lat":40.778,"lng":140.507}},"marker_type":"korea","badges":["species_unidentified"],"description":"수각류 공룡이 길게 이어 걸은 보행렬이 잘 남아 있어, 보폭으로 걷는 속도를 추정하는 연구에 쓰였습니다.","sources":["국가유산청 천연기념물 「화순 서유리 공룡화석 산지」"],"pbdb_nearby":10},{"id":"uiseong-tracks","name_ko":"의성 제오리 공룡 발자국","scientific_name":null,"taxon_group":"sauropod","tree_node_id":"sauropoda","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[120,100],"location":{"name":"경북 의성 금성면 제오리","modern":{"lat":36.29,"lng":128.7},"paleo":{"lat":42.105,"lng":142.11}},"marker_type":"korea","badges":["species_unidentified"],"description":"경상분지 북부의 호숫가 퇴적층에 용각류와 조각류 발자국이 함께 남아 있습니다. 비스듬히 기운 바위 면에 물결자국과 함께 보존되어 당시 물가 환경을 보여줍니다.","sources":["국가유산청 천연기념물 「의성 제오리 공룡발자국 화석산지」"],"pbdb_nearby":32},{"id":"haenam-pterosaur-tracks","name_ko":"해남 우항리 익룡 발자국","scientific_name":"Haenamichnus uhangriensis","taxon_group":"pterosaur","tree_node_id":"pterosauria","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[90,80],"location":{"name":"전남 해남 황산면 우항리","modern":{"lat":34.71,"lng":126.43},"paleo":{"lat":40.298,"lng":139.948}},"marker_type":"korea","badges":["not_dinosaur","trace_fossil"],"description":"날개를 접고 네 발로 걸은 익룡의 발자국입니다. 앞발·뒷발 자국 크기로 보아 매우 큰 익룡이 남긴 것으로 추정됩니다. 익룡은 공룡과 가까운 친척이지만 공룡은 아닙니다.","sources":["Hwang et al. (2002) Geological Magazine","국가유산청 천연기념물 「해남 우항리 공룡·익룡·새발자국 화석산지」"],"pbdb_nearby":15},{"id":"haenam-bird-tracks","name_ko":"해남 우항리 물새 발자국","scientific_name":"Uhangrichnus chuni","taxon_group":"bird","tree_node_id":"aves","fossil_type":"trackway","era_id":"cretaceous","age_range_ma":[90,80],"location":{"name":"전남 해남 황산면 우항리","modern":{"lat":34.73,"lng":126.46},"paleo":{"lat":40.321,"lng":139.976}},"marker_type":"korea","badges":["trace_fossil"],"description":"발가락 사이에 물갈퀴 흔적이 있는 새 발자국으로, 물갈퀴가 있는 새 발자국 가운데 아주 오래된 기록으로 알려져 있습니다. 백악기 호숫가에 이미 물새가 살았음을 보여줍니다.","sources":["Yang et al. (1995) Ichnos","국가유산청 천연기념물 「해남 우항리 공룡·익룡·새발자국 화석산지」"],"pbdb_nearby":4},{"id":"sihwa-eggs","name_ko":"화성 시화호 공룡알","scientific_name":null,"taxon_group":"dinosaur","tree_node_id":"dinosauria","fossil_type":"egg","era_id":"cretaceous","age_range_ma":[90,70],"location":{"name":"경기 화성 송산면 고정리 (시화호 일대)","modern":{"lat":37.24,"lng":126.75},"paleo":{"lat":42.84,"lng":139.84}},"marker_type":"korea","badges":["species_unidentified"],"description":"시화호 간척지 일대에서 공룡알 둥지 화석이 다수 발견되었습니다. 알껍데기만으로 어떤 공룡의 알인지 특정하기 어려워 '공룡' 수준으로 연결했습니다.","sources":["국가유산청 천연기념물 「화성 고정리 공룡알 화석 산지」"],"pbdb_nearby":38},{"id":"bibong-eggs","name_ko":"보성 비봉리 공룡알","scientific_name":null,"taxon_group":"dinosaur","tree_node_id":"dinosauria","fossil_type":"egg","era_id":"cretaceous","age_range_ma":[85,75],"location":{"name":"전남 보성 득량면 비봉리","modern":{"lat":34.77,"lng":127.19},"paleo":{"lat":40.439,"lng":140.75}},"marker_type":"korea","badges":["species_unidentified"],"description":"해안 절벽의 퇴적층에서 공룡알 둥지 여러 개가 확인되었습니다. 둥지가 여러 층에 걸쳐 나타나 같은 장소를 반복해서 산란지로 썼을 가능성이 제기됩니다.","sources":["국가유산청 천연기념물 「보성 비봉리 공룡알 화석 산지」"],"pbdb_nearby":10},{"id":"koreanosaurus","name_ko":"코리아노사우루스","scientific_name":"Koreanosaurus boseongensis","taxon_group":"ornithopod","tree_node_id":"ornithopoda","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[85,75],"location":{"name":"전남 보성 득량면 비봉리","modern":{"lat":34.8,"lng":127.23},"paleo":{"lat":40.473,"lng":140.788}},"marker_type":"korea","badges":[],"description":"보성 공룡알 화석지 인근에서 나온 골격으로 명명된 소형 조각류입니다. 앞다리가 튼튼해 굴을 팠을 가능성이 논의되었습니다.","sources":["Huh et al. (2011) Naturwissenschaften","PBDB"],"pbdb_nearby":10},{"id":"koreaceratops","name_ko":"코리아케라톱스","scientific_name":"Koreaceratops hwaseongensis","taxon_group":"ceratopsian","tree_node_id":"ceratopsia","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[113,100],"location":{"name":"경기 화성 (전곡항 일대)","modern":{"lat":37.19,"lng":126.66},"paleo":{"lat":42.781,"lng":139.753}},"marker_type":"korea","badges":[],"description":"한국에서 처음 명명된 각룡류 공룡으로, 꼬리뼈의 높은 돌기가 특징입니다. 트리케라톱스로 대표되는 각룡류 계통의 초기 구성원으로 해석됩니다.","sources":["Lee, Ryan & Kobayashi (2011) Naturwissenschaften","PBDB"],"pbdb_nearby":38},{"id":"pukyongosaurus","name_ko":"부경고사우루스","scientific_name":"Pukyongosaurus millenniumi","taxon_group":"sauropod","tree_node_id":"sauropoda","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[130,113],"location":{"name":"경남 하동 금성면 갈사리","modern":{"lat":34.95,"lng":127.79},"paleo":{"lat":40.681,"lng":141.362}},"marker_type":"korea","badges":[],"description":"하동의 섬 해안에서 발견된 목뼈·등뼈 등 일부 골격으로 명명된 용각류입니다. 남은 뼈가 적어 정확한 분류 위치에는 여러 의견이 있습니다.","sources":["Dong, Paik & Kim (2001) Journal of the Paleontological Society of Korea","PBDB"],"pbdb_nearby":18},{"id":"jinju-fish","name_ko":"진주층 민물고기 화석","scientific_name":null,"taxon_group":"fish","tree_node_id":"teleostei","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[113,106],"location":{"name":"경남 진주·사천 일대 (진주층)","modern":{"lat":35.1,"lng":128.05},"paleo":{"lat":40.857,"lng":141.616}},"marker_type":"korea","badges":["species_unidentified"],"description":"진주층의 고운 호수 퇴적층에서는 작은 민물고기 골격이 납작하게 눌린 채 발견됩니다. 공룡이 걷던 호숫가 바로 그 호수에 살던 물고기들입니다.","sources":["국내 진주층 고생물 연구 (개략)","PBDB"],"pbdb_nearby":143},{"id":"futabasaurus","name_ko":"후타바사우루스 (후쿠시마)","scientific_name":"Futabasaurus suzukii","taxon_group":"marine_reptile","tree_node_id":"plesiosauria","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[86,84],"location":{"name":"일본 후쿠시마현 이와키","modern":{"lat":37.05,"lng":140.89},"paleo":{"lat":46.318,"lng":155.951}},"marker_type":"east_asia_reference","badges":["not_dinosaur","east_asia_reference"],"description":"고등학생이 발견해 화제가 된 일본의 수장룡입니다. 한반도에서는 해양 파충류 골격이 거의 나오지 않아, 같은 시대 동아시아 바다의 모습을 보여주는 참고 자료로 넣었습니다.","sources":["Sato, Hasegawa & Manabe (2006) Palaeontology","PBDB"],"pbdb_nearby":null},{"id":"phosphorosaurus","name_ko":"포스포로사우루스 (홋카이도)","scientific_name":"Phosphorosaurus ponpetelegans","taxon_group":"marine_reptile","tree_node_id":"mosasauridae","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[73,71],"location":{"name":"일본 홋카이도 무카와","modern":{"lat":42.65,"lng":141.95},"paleo":{"lat":51.966,"lng":156.475}},"marker_type":"east_asia_reference","badges":["not_dinosaur","east_asia_reference"],"description":"눈이 앞쪽을 향한 작은 모사사우루스류로, 밤에 사냥했을 가능성이 제기되었습니다. 모사사우루스는 바다로 간 도마뱀의 친척이며 공룡이 아닙니다.","sources":["Konishi et al. (2016) Journal of Systematic Palaeontology","PBDB"],"pbdb_nearby":null},{"id":"sinosauropteryx","name_ko":"시노사우롭테릭스 (랴오닝)","scientific_name":"Sinosauropteryx prima","taxon_group":"theropod","tree_node_id":"theropoda","fossil_type":"skeleton","era_id":"cretaceous","age_range_ma":[125,122],"location":{"name":"중국 랴오닝성 베이퍄오","modern":{"lat":41.6,"lng":120.8},"paleo":{"lat":46.477,"lng":132.546}},"marker_type":"east_asia_reference","badges":["east_asia_reference"],"description":"깃털 흔적이 처음으로 확인된 비조류 공룡입니다. 새가 수각류 공룡에서 갈라져 나왔다는 생각을 강하게 뒷받침한 화석이라 참고 자료로 넣었습니다.","sources":["Ji & Ji (1996) Chinese Geology","PBDB"],"pbdb_nearby":null},{"id":"yeongwol-trilobites","name_ko":"영월 삼엽충","scientific_name":null,"taxon_group":"invertebrate","tree_node_id":"trilobita","fossil_type":"skeleton","era_id":"paleozoic","age_range_ma":[500,480],"location":{"name":"강원 영월 일대 (조선누층군)","modern":{"lat":37.19,"lng":128.46},"paleo":{"lat":-8.939,"lng":79.737}},"marker_type":"korea","badges":["species_unidentified"],"description":"지금은 산골인 영월의 석회암에서 바다에 살던 삼엽충이 나옵니다. 이 땅이 고생대에는 따뜻하고 얕은 바다였다는 증거입니다.","sources":["PBDB"],"pbdb_nearby":398},{"id":"taebaek-brachiopods","name_ko":"태백 완족류","scientific_name":null,"taxon_group":"invertebrate","tree_node_id":"brachiopoda","fossil_type":"skeleton","era_id":"paleozoic","age_range_ma":[490,470],"location":{"name":"강원 태백 일대 (조선누층군)","modern":{"lat":37.16,"lng":128.98},"paleo":{"lat":-9.007,"lng":80.152}},"marker_type":"korea","badges":["species_unidentified"],"description":"조개처럼 두 장의 껍데기를 가졌지만 조개와는 전혀 다른 동물인 완족류 화석입니다. 오늘날 서해 갯벌의 개맛이 이 계통의 친척입니다.","sources":["PBDB"],"pbdb_nearby":135},{"id":"danyang-conodonts","name_ko":"단양 코노돈트","scientific_name":null,"taxon_group":"fish","tree_node_id":"conodonta","fossil_type":"tooth","era_id":"paleozoic","age_range_ma":[490,470],"location":{"name":"충북 단양 일대 (조선누층군)","modern":{"lat":36.98,"lng":128.36},"paleo":{"lat":-9.141,"lng":79.637}},"marker_type":"korea","badges":["species_unidentified","disputed"],"description":"뱀장어 모양의 원시적인 동물이 남긴 1mm 안팎의 이빨 모양 화석입니다. 지층의 나이를 재는 데 널리 쓰이며, 척추동물에 속하는지는 학계에서 논쟁 중입니다.","sources":["PBDB"],"pbdb_nearby":0},{"id":"gunanggul-bear","name_ko":"단양 구낭굴 곰 화석","scientific_name":"Ursus sp.","taxon_group":"mammal","tree_node_id":"ursidae","fossil_type":"skeleton","era_id":"ice_age","age_range_ma":[0.13,0.01],"location":{"name":"충북 단양 가곡면 여천리 구낭굴","modern":{"lat":37.03,"lng":128.41},"paleo":{"lat":37.03,"lng":128.41}},"marker_type":"korea","badges":["species_unidentified"],"description":"석회암 동굴 퇴적층에서 곰을 비롯한 플라이스토세 포유류 뼈가 나왔습니다. 빙하기 한반도 내륙의 동물상을 보여줍니다.","sources":["국내 구낭굴 발굴 보고 (개략)"],"pbdb_nearby":0},{"id":"gunanggul-deer","name_ko":"단양 구낭굴 사슴류 화석","scientific_name":null,"taxon_group":"mammal","tree_node_id":"cervidae","fossil_type":"skeleton","era_id":"ice_age","age_range_ma":[0.13,0.01],"location":{"name":"충북 단양 가곡면 여천리 구낭굴","modern":{"lat":37.06,"lng":128.44},"paleo":{"lat":37.06,"lng":128.44}},"marker_type":"korea","badges":["species_unidentified"],"description":"구낭굴에서는 사슴류 뼈가 특히 많이 나왔습니다. 오늘날 고라니·노루와 같은 사슴과의 빙하기 친척들입니다.","sources":["국내 구낭굴 발굴 보고 (개략)"],"pbdb_nearby":0}]